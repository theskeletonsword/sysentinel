#!/bin/sh
# SPDX-License-Identifier: MIT OR GPL-2.0-or-later
#
# initramfs-tools RUNTIME hook, init-top: bring up the control channel and the
# webcam stack before udev's coldplug, mirroring dracut's pre-udev hook.
#
# init-top is the earliest stage initramfs-tools offers, which is where this
# has to be: /proc/sysentinel_metrics is the early control/verdict channel, and
# the capture in init-premount needs uvcvideo already resident.

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0 ;;
esac

modprobe -q sysentinel_metrics 2>/dev/null || true
modprobe -q uvcvideo           2>/dev/null || true

exit 0
